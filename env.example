# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me-to-a-secure-random-string

# For production:
# NEXTAUTH_URL=https://your-production-domain.com
# NEXTAUTH_SECRET=generate-a-secure-32-character-random-string

# Backend API Base URL
# Development (backend runs on port 3000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Production (update to your production backend URL)
# NEXT_PUBLIC_API_BASE_URL=https://api.your-production-domain.com

# Auth Secret (for NextAuth v4/v5)
AUTH_SECRET=your-auth-secret-change-in-production
